# ============================================================
# HengSeng Stock Sentiment & Price Prediction Agent
# Environment Variable Configuration Template
# ============================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# Apify API Token (used for social media collection from LIHKG and Telegram)
APIFY_TOKEN=your_apify_token_here

# Exa API Key (used for financial and stock news collection)
EXA_API_KEY=your_exa_api_key_here

# Groq API Key (used for fast LLM inference for sentiment analysis)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (if using OpenAI models for sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here
